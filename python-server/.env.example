# Environment
ENVIRONMENT=development
DEBUG=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Neon
NEON_DATABASE_URL=postgresql://user:password@host/dbname
NEON_POOLER_URL=postgresql://user:password@host/dbname

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Shopify
SHOPIFY_STORE_NAME=your-store
SHOPIFY_ACCESS_TOKEN=shpat_...
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# Resend
RESEND_API_KEY=re_...

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Emails
SUPPORT_EMAIL=support@nkubu.garage
NOREPLY_EMAIL=noreply@nkubu.garage
